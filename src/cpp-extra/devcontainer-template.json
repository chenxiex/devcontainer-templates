{
    "id": "cpp-extra",
    "version": "1.2.5",
    "name": "C++ extra",
    "description": "Develop C++ applications on Linux. Includes Debian C++ build tools and dev tools such as clangd.",
    "documentationURL": "https://github.com/chenxiex/devcontainer-templates/tree/main/src/cpp-extra",
    "publisher": "chenxiex",
    "licenseURL": "https://github.com/chenxiex/devcontainer-templates/blob/main/LICENSE",
    "options": {
        "imageVariant": {
            "type": "string",
            "description": "Published Debian / Ubuntu image variant:",
            "proposals": [
                "debian13",
                "ubuntu24.04"
            ],
            "default": "debian13"
        },
        "reinstallCmakeVersionFromSource": {
            "type": "string",
            "description": "Install CMake version different from what base image has already installed.",
            "proposals": [
                "none",
                "3.21.5",
                "3.22.2"
            ],
            "default": "none"
        }
    },
    "platforms": ["C++"],
    "optionalPaths": [
        ".github/*"
    ]
}

{
    "id": "devops",
    "version": "1.0.0",
    "name": "DevOps",
    "description": "Dev environment on Debian Trixie for Dockerfiles, CI workflows and helper scripts. Includes shellcheck and shfmt.",
    "documentationURL": "https://github.com/chenxiex/devcontainer-templates/tree/main/src/devops",
    "publisher": "chenxiex",
    "licenseURL": "https://github.com/chenxiex/devcontainer-templates/blob/main/LICENSE",
    "options": {
        "imageVariant": {
            "type": "string",
            "description": "Published Debian image variant:",
            "proposals": [
                "trixie"
            ],
            "default": "trixie"
        }
    },
    "platforms": ["Any"],
    "optionalPaths": [
        ".github/*"
    ]
}
